{
  "name": "@tacos-ui/react",
  "version": "1.0.0",
  "description": "React component for Tacos UI",
  "keywords": [
    "Ark UI",
    "Panda CSS",
    "Preset",
    "Tacos UI"
  ],
  "homepage": "https://github.com/samuelbillaud/tacos-ui#readme",
  "bugs": {
    "url": "https://github.com/samuelbillaud/tacos-ui/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Samuel Billaud",
    "email": "samuel.billaud1990@gmail.com",
    "url": "https://github.com/samuelbillaud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelbillaud/tacos-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "panda codegen",
    "build": "tsdown",
    "build-storybook": "storybook build",
    "dev": "storybook dev -p 6006",
    "typecheck": "tsc",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@ark-ui/react": "5.38.1",
    "@tacos-ui/panda-preset": "workspace:*",
    "@tacos-ui/styled-system": "workspace:*",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@pandacss/dev": "1.12.0",
    "@storybook/react": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "chromatic": "^18.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "^10.5.8",
    "typescript": "7.0.2",
    "vite": "^8.2.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
